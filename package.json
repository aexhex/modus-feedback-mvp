{
  "name": "modus-feedback-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "MVP системы обратной связи и предложений сотрудников (хакатон ГК «Модус Трейд»)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node -e \"process.env.DEMO_MODE ??= '1'; import('./server.js')\"",
    "reset": "node -e \"process.env.RESET='1'; process.env.DEMO_MODE ??= '1'; import('./server.js')\"",
    "test": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.js test/",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --config playwright.screenshots.config.js",
    "voice": "python scripts/voice-neural.py",
    "voice:offline": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/voice.ps1",
    "video": "playwright test --config playwright.video.config.js",
    "video:voice": "node scripts/mix-voice.mjs",
    "i18n:check": "node scripts/i18n-extract.mjs --list",
    "backup": "node scripts/backup.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0"
  }
}
