{
  "name": "modus-feedback-mvp",
  "version": "0.1.0",
  "private": true,
  "description": "MVP системы обратной связи и предложений сотрудников (хакатон ГК «Модус Трейд»)",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node -e \"process.env.DEMO_MODE ??= '1'; import('./server.js')\"",
    "reset": "node -e \"process.env.RESET='1'; process.env.DEMO_MODE ??= '1'; import('./server.js')\"",
    "test": "node --test --experimental-test-coverage --test-coverage-include=src/**/*.js test/",
    "test:e2e": "playwright test",
    "screenshots": "playwright test --config playwright.screenshots.config.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0"
  }
}
