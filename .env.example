# Образец настроек «Голоса сотрудника». Настоящих значений здесь нет.
# Для демонстрации ничего задавать не нужно: `npm start` запускает демо-режим со встроенным демо-порталом
# Битрикс24 и 1С, учебной почтой и демо-данными.
# Для рабочей установки скопируйте файл в .env (он в .gitignore), заполните нужное и запустите:
#   node --env-file=.env server.js
# Подробное описание каждой переменной — в README, раздел «Запуск».

# --- Запуск ---
PORT=3000
DB_PATH=data/feedback.db
UPLOADS_DIR=data/uploads
# 1 — демо-режим: демо-портал, кнопка сброса демо-данных (npm start включает сам)
DEMO_MODE=
# 0 — без демо-датасета: в пустой базе только администратор
DEMO_DATA=
ADMIN_NAME=
# ID администратора в Битрикс24 — для входа только через портал
ADMIN_B24_ID=
# 1 — вход выбором из списка без пароля вне демо (только внутренняя сеть)
ALLOW_LIST_LOGIN=

# --- Адрес и безопасность ---
# Адрес системы для ссылок в уведомлениях; https:// включает Secure-cookie
PUBLIC_URL=
COOKIE_SECURE=
# 1 — за своим HTTPS-прокси (адрес клиента из X-Forwarded-For)
TRUST_PROXY=
MUTATIONS_PER_MINUTE=60

# --- Сроки ---
# Часовой пояс компании по умолчанию, часы от UTC (5 — Казахстан, 3 — Москва)
BUSINESS_TZ_OFFSET=5
PROD_CALENDAR_URL=
# ru или kz
PROD_CALENDAR_COUNTRY=

# --- Битрикс24 ---
# Входящий вебхук портала: https://<портал>.bitrix24.kz/rest/<id>/<ключ>/
B24_WEBHOOK_URL=
# Локальное приложение портала — вход через Битрикс24
B24_CLIENT_ID=
B24_CLIENT_SECRET=

# --- 1С УТ ---
ONEC_ODATA_URL=
ONEC_USER=
ONEC_PASSWORD=
# Токен, с которым 1С забирает выгрузку обращений
ONEC_EXPORT_TOKEN=

# --- Почта ---
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_ALLOW_PLAIN=

# --- Push-уведомления (без них ключи создаются при первом запуске и хранятся в базе) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# --- Резервные копии ---
BACKUP_DIR=
BACKUP_KEEP=14
